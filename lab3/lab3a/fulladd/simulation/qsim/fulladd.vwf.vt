`timescale 1 ps/ 1 ps
module fulladd_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Cin;
reg x;
reg y;
// wires                                               
wire Cout;
wire s;

// assign statements (if any)                          
fulladd i1 (
// port map - connection between master ports and signals/registers   
	.Cin(Cin),
	.Cout(Cout),
	.s(s),
	.x(x),
	.y(y)
);
initial 
begin 
#400000 $finish;
end 

// x
initial
begin
	x = 1'b0;
	x = #100000 1'b1;
	x = #100000 1'b0;
	x = #100000 1'b1;
end 

// y
initial
begin
	y = 1'b0;
	y = #50000 1'b1;
	y = #50000 1'b0;
	y = #50000 1'b1;
	y = #50000 1'b0;
	y = #50000 1'b1;
	y = #50000 1'b0;
	y = #50000 1'b1;
end 

// Cin
initial
begin
	Cin = 1'b0;
	Cin = #200000 1'b1;
end 
endmodule

